# Database Configuration (RDS PostgreSQL)
# Example values:
# DB_HOST=your-db-instance.abcdefg.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=StrongP@ssw0rd!
# DB_DATABASE=aws_cloud_app
DB_HOST=your-db-instance.abcdefg.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=StrongP@ssw0rd!
DB_DATABASE=aws_cloud_app

# AWS Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 Configuration
# S3_BUCKET_NAME=my-app-public-bucket
# S3_BUCKET_REGION=us-east-1
S3_BUCKET_NAME=my-app-public-bucket
S3_BUCKET_REGION=us-east-1

# SNS Configuration
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mi-topico-notificaciones
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mi-topico-notificaciones

# DynamoDB Configuration
# DYNAMODB_TABLE_NAME=sesiones-alumnos
# DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=sesiones-alumnos
DYNAMODB_REGION=us-east-1
